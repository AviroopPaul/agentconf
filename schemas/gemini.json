    {
      "key": "general.notificationMethod",
      "file": "settings.json",
      "type": "enum",
      "enumValues": ["auto", "osc9", "osc777", "bell"],
      "default": "auto",
      "scopes": ["user", "project"],
      "category": "Notifications",
      "summary": "How to deliver terminal run-event notifications.",
      "docsUrl": "https://geminicli.com/docs/cli/notifications/",
      "flags": ["experimental"],
      "concept": "notifications"
    },
    {
      "key": "general.checkpointing.enabled",
      "file": "settings.json",
      "type": "boolean",
      "default": false,
      "scopes": ["user", "project"],
