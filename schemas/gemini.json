  "paths": [
    {
      "path": "~/.gemini/settings.json",
      "kind": "settings",
      "scope": "user",
      "editable": true,
      "summary": "User-level Gemini CLI configuration, nested by domain (general, ui, security, mcpServers, and so on).",
      "docsUrl": "https://geminicli.com/docs/cli/settings/"
    },
    {
      "path": "~/.gemini/GEMINI.md",
      "kind": "instructions",
      "scope": "user",
      "editable": true,
      "summary": "Global context file with default instructions loaded into every project.",
      "docsUrl": "https://geminicli.com/docs/cli/gemini-md/"
    },
    {
      "path": "~/.gemini/skills/",
      "kind": "skills",
      "scope": "user",
      "editable": true,
      "summary": "User-level Agent Skills, one directory per skill with a SKILL.md entrypoint. Often symlinked from a shared ~/.agents/skills directory.",
      "docsUrl": "https://geminicli.com/docs/cli/skills/"
    },
    {
      "path": "~/.gemini/trustedFolders.json",
      "kind": "trust",
      "scope": "user",
      "editable": true,
      "summary": "Per-folder trust decisions from the Trusted Folders dialog.",
      "docsUrl": "https://geminicli.com/docs/cli/trusted-folders/"
    },
    {
      "path": "~/.gemini/commands/",
      "kind": "commands",
      "scope": "user",
      "editable": true,
      "summary": "User-defined custom slash commands as .toml files.",
      "docsUrl": "https://geminicli.com/docs/cli/custom-commands/"
    },
    {
      "path": "~/.gemini/extensions/",
      "kind": "plugins",
      "scope": "user",
      "editable": true,
      "summary": "Installed Gemini CLI extensions, which can bundle MCP servers, skills, and context files.",
      "docsUrl": "https://geminicli.com/docs/extensions/"
    },
    {
      "path": "~/.gemini/.env",
      "kind": "settings",
      "scope": "user",
      "editable": true,
      "summary": "User-wide environment variables, such as GEMINI_API_KEY or GOOGLE_CLOUD_PROJECT, loaded if no closer .env file is found.",
      "docsUrl": "https://geminicli.com/docs/get-started/authentication/"
    },
    {
      "path": "~/.gemini/projects.json",
      "kind": "state",
      "scope": "user",
      "editable": false,
      "summary": "Registry of known projects the CLI has been run in."
    },
    {
      "path": "~/.gemini/state.json",
      "kind": "state",
      "scope": "user",
      "editable": false,
      "summary": "Miscellaneous persisted CLI state."
    },
    {
      "path": "~/.gemini/installation_id",
      "kind": "state",
      "scope": "user",
      "editable": false,
      "summary": "Anonymous installation identifier used for usage statistics."
    },
    {
      "path": "~/.gemini/history/",
      "kind": "state",
      "scope": "user",
      "editable": false,
      "summary": "Shadow git repositories holding checkpoint snapshots, one per project hash.",
      "docsUrl": "https://geminicli.com/docs/cli/checkpointing/"
    },
    {
      "path": "~/.gemini/tmp/",
      "kind": "state",
      "scope": "user",
      "editable": false,
      "summary": "Per-project temporary data, including checkpoint conversation history and session transcripts.",
      "docsUrl": "https://geminicli.com/docs/cli/checkpointing/"
    },
    {
      "path": "~/.gemini/antigravity/",
      "kind": "state",
      "scope": "user",
      "editable": false,
      "summary": "State used by Antigravity IDE integration."
    },
    {
      "path": "~/.gemini/oauth_creds.json",
      "kind": "credential",
      "scope": "user",
      "editable": false,
      "summary": "Cached OAuth credentials from Google account sign-in. Never read or display this file."
    },
    {
      "path": "~/.gemini/google_accounts.json",
      "kind": "credential",
      "scope": "user",
      "editable": false,
      "summary": "Cached Google account identity data. Never read or display this file."
    },
    {
      "path": "~/.gemini/mcp-oauth-tokens.json",
      "kind": "credential",
      "scope": "user",
      "editable": false,
      "summary": "Cached OAuth tokens for MCP servers that require their own authentication. Never read or display this file."
    },
    {
      "path": "<project>/.gemini/settings.json",
      "kind": "settings",
      "scope": "project",
      "editable": true,
      "summary": "Project-level Gemini CLI configuration, merged over and overriding user settings.",
      "docsUrl": "https://geminicli.com/docs/cli/settings/"
    },
    {
      "path": "<project>/GEMINI.md",
      "kind": "instructions",
      "scope": "project",
      "editable": true,
      "summary": "Project context file with instructions specific to this codebase.",
      "docsUrl": "https://geminicli.com/docs/cli/gemini-md/"
    },
    {
      "path": "<project>/.gemini/skills/",
      "kind": "skills",
      "scope": "project",
      "editable": true,
      "summary": "Workspace Agent Skills, shared with the team through version control. Also readable via the .agents/skills alias.",
      "docsUrl": "https://geminicli.com/docs/cli/skills/"
    },
    {
      "path": "<project>/.gemini/commands/",
      "kind": "commands",
      "scope": "project",
      "editable": true,
      "summary": "Project-defined custom slash commands as .toml files, shared through version control.",
      "docsUrl": "https://geminicli.com/docs/cli/custom-commands/"
    },
    {
      "path": "<project>/.gemini/sandbox.Dockerfile",
      "kind": "rules",
      "scope": "project",
      "editable": true,
      "summary": "Custom Dockerfile extending the base sandbox image for this project.",
      "docsUrl": "https://geminicli.com/docs/reference/configuration/#sandboxing"
    },
    {
      "path": "<project>/.gemini/.env",
      "kind": "settings",
      "scope": "project",
      "editable": true,
      "summary": "Project-scoped environment variables, loaded before user-level .env files.",
      "docsUrl": "https://geminicli.com/docs/get-started/authentication/"
    }
  ]
}
