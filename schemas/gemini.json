    {
      "key": "security.folderTrust.enabled",
      "file": "settings.json",
      "type": "boolean",
      "default": true,
      "scopes": ["user", "project"],
      "category": "Permissions",
      "summary": "Require approving a folder before Gemini CLI loads its project-specific configuration.",
      "detail": "Disabled by default. When on, an untrusted folder runs in a restricted safe mode: no workspace settings, no project .env, no MCP servers, no custom commands.",
      "docsUrl": "https://geminicli.com/docs/cli/trusted-folders/",
      "concept": "trust.projects"
