    {
      "key": "general.defaultApprovalMode",
      "file": "settings.json",
      "type": "enum",
      "enumValues": ["default", "auto_edit", "plan"],
      "default": "default",
      "scopes": ["user", "project"],
      "category": "Permissions",
      "summary": "Default approval mode for tool execution: prompt, auto-approve edits, or read-only plan mode.",
      "detail": "YOLO mode, which auto-approves every action, cannot be set here and is only available via the --yolo flag or --approval-mode=yolo.",
      "docsUrl": "https://geminicli.com/docs/reference/configuration/#general",
      "concept": "permissions.mode"
    },
    {
      "key": "general.enableAutoUpdate",
      "file": "settings.json",
      "type": "boolean",
      "default": true,
      "scopes": ["user", "project"],
      "category": "Updates",
      "summary": "Enable automatic updates of Gemini CLI.",
      "docsUrl": "https://geminicli.com/docs/reference/configuration/#general",
      "concept": "updates"
    },
    {
      "key": "general.enableNotifications",
      "file": "settings.json",
      "type": "boolean",
      "default": false,
      "scopes": ["user", "project"],
      "category": "Notifications",
      "summary": "Send terminal notifications when a session needs input or completes.",
      "detail": "Experimental. Uses the OSC 9 terminal escape sequence, falling back to a terminal bell (BEL) on unsupported terminals.",
