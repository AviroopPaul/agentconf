    {
      "key": "permissions.allow",
      "file": "cli-config.json",
      "type": "array",
      "default": [],
      "scopes": ["user", "project"],
      "category": "Permissions",
      "summary": "List of Tool(arg) strings the agent may run without asking.",
      "detail": "Entries use a Tool(arg) syntax such as Shell(ls), Read(src/**/*.ts), or Mcp(server:tool). A matching deny rule always wins over an allow rule.",
      "docsUrl": "https://cursor.com/docs/cli/reference/permissions#configuration",
      "concept": "permissions.rules"
    },
    {
      "key": "permissions.deny",
      "file": "cli-config.json",
      "type": "array",
      "default": [],
      "scopes": ["user", "project"],
      "category": "Permissions",
      "summary": "List of Tool(arg) strings the agent is always blocked from running.",
      "detail": "Uses the same Tool(arg) syntax as permissions.allow: Shell(commandBase), Read(pathOrGlob), Write(pathOrGlob), WebFetch(domainOrPattern), Mcp(server:tool).",
      "docsUrl": "https://cursor.com/docs/cli/reference/permissions#configuration",
      "concept": "permissions.rules"
    },
    {
      "key": "channel",
