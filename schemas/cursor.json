      "docsUrl": "https://cursor.com/docs/mcp"
    },
    {
      "path": "<project>/.cursor/rules/",
      "kind": "rules",
      "scope": "project",
      "editable": true,
      "summary": "Project rules, version-controlled and scoped by path patterns.",
      "docsUrl": "https://cursor.com/docs/rules"
    },
    {
      "path": "<project>/.cursor/hooks.json",
      "kind": "hooks",
      "scope": "project",
      "editable": true,
      "summary": "Project-level lifecycle hooks, checked into version control with the repo.",
      "docsUrl": "https://cursor.com/docs/hooks"
    },
    {
      "path": "<project>/.cursor/cli.json",
      "kind": "settings",
      "scope": "project",
      "editable": true,
      "summary": "Project-level CLI overrides. Only permissions can be set here, every other CLI setting is global.",
      "docsUrl": "https://cursor.com/docs/cli/reference/configuration"
    },
    {
      "path": "<project>/AGENTS.md",
      "kind": "instructions",
      "scope": "project",
      "editable": true,
